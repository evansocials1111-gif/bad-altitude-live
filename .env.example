# ---- Branding ----
# Do not use a third party's show name or characters here without a license.
NEXT_PUBLIC_SHOW_NAME="Degen Den"
APP_URL=http://localhost:3000

# ---- Mode ----
# Leave unset: mock mode turns on automatically in development when TOKEN_MINT is empty.
# It can never run when NODE_ENV=production.
# DEV_MOCK_MODE=true

# ---- Required in production ----
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Supabase: Project Settings > Database > Connection string (session mode). Empty = embedded PGlite in .data/
DATABASE_URL=

# ---- Token ----
# Can also be set in Admin > Token & tiers, which takes precedence.
TOKEN_MINT=
TOKEN_SYMBOL=

# ---- Solana ----
# The public endpoint throttles heavily. Use a dedicated RPC provider in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Needed for holder counts. Without it the site shows "Unavailable".
HELIUS_API_KEY=
# A wallet you control, which receives dust transfers from wallets that can't sign messages.
# Without it, that verification option is disabled.
VERIFICATION_DEPOSIT_ADDRESS=
# Comma-separated. Signing in with one of these wallets grants admin.
ADMIN_WALLETS=

# ---- AI dialogue ----
# Without a key, dialogue comes from clearly labelled mock templates.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ---- Voice ----
# Also set a voice ID per character in Admin > Characters. Original or licensed voices only.
# Without these, the viewer's browser speaks the lines.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Audio storage (optional) ----
# Without these, audio is written to .data/audio on the server's disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=show-audio

# ---- Licensed characters ----
# Only set true if this deployment holds the license for the licensed roster.
LICENSED_ROSTER_ENABLED=false
DIRECTOR_ENABLED=true

# Free dialogue: install Ollama (https://ollama.com), run `ollama pull llama3.2`, and leave
# ANTHROPIC_API_KEY empty. Every chat message then gets a newly written reply at no cost.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_ENABLED=true
